    "這組快速鍵已被其他 App 占用，請換一組。": {
      "comment": "出現在 SettingsView.swift（英文：This shortcut is already used by another app. Choose a different one.）",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tastenkurzbefehl wird bereits von einer anderen App verwendet. Wähle einen anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shortcut is already used by another app. Choose a different one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ya usa este atajo. Elige uno distinto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci est déjà utilisé par une autre app. Choisissez-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa scorciatoia è già usata da un’altra app. Scegline un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットは別のAppで使用されています。別のショートカットを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키는 다른 앱에서 이미 사용 중입니다. 다른 단축키를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze toetscombinatie wordt al door een andere app gebruikt. Kies een andere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atalho já é usado por outro app. Escolha um diferente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сочетание клавиш уже занято другим приложением. Выберите другое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kısayol başka bir uygulama tarafından kullanılıyor. Farklı bir kısayol seçin."
