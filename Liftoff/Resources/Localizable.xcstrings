        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo restante encontrado. Apenas o app será removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаточных файлов не найдено. Будет удалено только само приложение."
