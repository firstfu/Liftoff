      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Restdateien gefunden. Nur die App selbst wird entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No leftover files found. Only the app itself will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron archivos residuales. Solo se eliminará la propia app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier résiduel trouvé. Seule l’app elle-même sera supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file residuo trovato. Verrà rimossa solo l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りのファイルは見つかりませんでした。App本体のみ削除されます。"
